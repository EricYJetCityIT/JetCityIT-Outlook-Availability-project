  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "COSMOS_CONNECTION_STRING": "<copy from jetcityit-cosmos account's Keys blade in the Azure Portal>",
    "COSMOS_DATABASE": "jetcityit",
    "AAD_TENANT_ID": "a2b534e7-8d8b-4c5f-ae4b-5076fd677ff4",
    "AAD_CLIENT_ID": "b367d366-39f5-4fdc-a5e9-9d634ca37b5e",
    "SMARTSHEET_API_TOKEN": "<generate from Smartsheet: Account > Apps & Integrations > API Access>",
    "SMARTSHEET_SHEET_ID": "3896324323757956",
    "REPORT_SHEET_ID": "6097352604837764",
    "SYNC_SECRET": "<shared secret the GitHub Actions cron workflows send as X-Sync-Secret; must match the GitHub repo secret of the same name>",
    "MAIL_CLIENT_SECRET": "<client secret for the JetCity Availability App registration (Azure Portal > App registrations > Certificates & secrets); used ONLY for the app-only Graph Mail.Send call the availability-reminder cron makes -- also requires an admin-consented Mail.Send APPLICATION permission on that same app registration>",
    "RATE_LIMIT_PER_MIN": "120",
    "EDITOR_UPNS": "<comma-separated emails allowed to CHANGE data (reassign crew, clear availability weeks), e.g. dylanm@jetcityit.com,ericy@jetcityit.com. Everyone else is read-only. Optional if using the Entra 'DataEditor' app role instead.>",
    "FINANCE_UPNS": "<comma-separated emails in the financial group (Invoice tab). Empty/unset => nobody. Independent of EDITOR_UPNS.>",
    "PLANNER_UPNS": "<comma-separated emails in the Project Planners group (Project Planning tab). Empty/unset => nobody. Independent of EDITOR_UPNS and FINANCE_UPNS.>",
    "TESTER_UPNS": "<comma-separated emails in the Testers group — a private group that unlocks in-progress features (today the Job Sheets tab). Empty/unset => nobody. Independent of the other groups. e.g. dylanm@jetcityit.com,ericy@jetcityit.com>",
    "JOBSHEET_WORKSPACE_ID": "<one or more numeric Smartsheet workspace IDs (comma-separated) whose sheets the Job Sheets tab may read/edit (Testers group). Client-identifying — set in Azure app settings only, never commit a real value. The /api/jobsheet endpoints only ever touch sheets inside these workspaces. e.g. a real client workspace + a sandbox workspace for testing.>"
  }
}
